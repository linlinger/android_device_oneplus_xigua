android_app {
    name: "OplusRefreshRate",

    srcs: ["java/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
    ],

    optimize: {
        enabled: false,
    },
}
