<?xml version="1.0" encoding="utf-8"?>
<!-- Lineage Settings 请求的 LiveDisplay 权限.
     白名单文件必须与 priv-app 同分区: Settings 在 /system_ext/priv-app,
     所以装到 system_ext, frameworks/base 的 privapp-permissions-platform.xml
     (/system 分区) 罩不到它. 缺失时 AppIdPermissionPolicy.onSystemReady 抛
     IllegalStateException → SystemServer crash loop. -->
<permissions>
    <privapp-permissions package="com.android.settings">
        <permission name="lineageos.permission.MANAGE_LIVEDISPLAY"/>
    </privapp-permissions>
</permissions>
